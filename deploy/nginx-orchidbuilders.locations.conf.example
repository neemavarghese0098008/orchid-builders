# Add these locations inside the existing HTTPS server block for orchidbuilders.in.
# Keep the existing TLS, certificate, logging, and unrelated site locations intact.
# Set the server-level root to the directory containing both public index.html
# and the admin/ directory (for example: /domains/orchidbuilders.in/public_html).

location = /admin {
    return 301 /admin/;
}

# The admin build is deployed to <document-root>/admin/.
# Every admin route falls back to the admin app's own index.html.
location ^~ /admin/ {
    try_files $uri $uri/ /admin/index.html;
}

# Image batches can contain up to 100 files of 8 MB each.
location ^~ /api/uploads/ {
    client_max_body_size 820m;
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# No URI suffix on proxy_pass preserves /api/... for Express.
location ^~ /api/ {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Express serves files from the persistent UPLOAD_DIR at /uploads/.
location ^~ /uploads/ {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Preserve the existing public site fallback in the server block:
# location / { try_files $uri $uri/ /index.html; }
