<!-- WHO WE ARE -->
<section class="sec" id="who-we-are">
  <div class="wrap">
    <div class="wwa-grid">
      <div>
        <span class="label" data-reveal>01 — Who We Are</span>
        <h2 class="h2" style="margin:24px 0" data-reveal>Spaces Built for the Way You <em class="serif-it gold">Live and Work</em></h2>
        <p class="leads" data-reveal>From new homes and commercial spaces to carefully planned renovations, we manage every project with clarity, quality and attention to detail.</p>
        <p class="muted" style="margin-top:18px" data-reveal>Our work brings together thoughtful planning, durable construction and interiors that feel natural to use every day, whether the space is personal, professional or being renewed.</p>
        
        <div style="margin-top:38px" data-reveal><a href="about.html" class="u-line" data-testid="wwa-discover-btn">Discover Our Story <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
